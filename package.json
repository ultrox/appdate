{
  "version": "1.1.2",
  "name": "@ma.vu/appdate",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ultrox/appdate"
  },
  "main": "dist/index.cjs",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "test:vitest": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:ui": "vitest --ui --no-open --api.host 0.0.0.0",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run format",
    "docs": "typedoc src/index.ts",
    "bump": "npm version patch",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/ui": "~2.0.5",
    "bun-types": "latest",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsup": "~8.2.4",
    "typedoc": "~0.28.15",
    "vite": "~5.3.5",
    "vitest": "~2.0.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dayjs": "~1.11.12"
  }
}
